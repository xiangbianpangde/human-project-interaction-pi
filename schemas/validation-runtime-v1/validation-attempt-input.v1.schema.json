{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hpi:wire:validation-attempt-input:v1",
  "title": "HPI Validation Attempt Input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "validation_attempt_id",
    "attempt_family",
    "project_id",
    "adapter",
    "task_ref",
    "contract_refs",
    "input_refs",
    "declared_read_set",
    "isolated_write_root",
    "input_digest",
    "input_revision",
    "execution_contract",
    "validation_contract",
    "authority",
    "declared_at"
  ],
  "properties": {
    "schema": {
      "const": "hpi/wire/validation-attempt-input/v1"
    },
    "validation_attempt_id": {
      "$ref": "urn:hpi:wire:validation-runtime-common:v1#/$defs/validation_attempt_id"
    },
    "attempt_family": {
      "const": "TS001_VALIDATION_RUNTIME_V1"
    },
    "project_id": {
      "const": "HPI-TS001-PILOT"
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_id",
        "adapter_version"
      ],
      "properties": {
        "adapter_id": {
          "const": "ts001-pilot"
        },
        "adapter_version": {
          "const": "0.1.0"
        }
      }
    },
    "task_ref": {
      "$ref": "urn:hpi:wire:execution-common:v2#/$defs/frozen_ref"
    },
    "contract_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:hpi:wire:execution-common:v2#/$defs/frozen_ref"
      }
    },
    "input_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:hpi:wire:execution-common:v2#/$defs/frozen_ref"
      }
    },
    "declared_read_set": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:hpi:wire:execution-common:v2#/$defs/scoped_path"
      }
    },
    "isolated_write_root": {
      "$ref": "urn:hpi:wire:execution-common:v2#/$defs/scoped_path"
    },
    "input_digest": {
      "$ref": "urn:hpi:wire:common:v1#/$defs/sha256"
    },
    "input_revision": {
      "$ref": "urn:hpi:wire:common:v1#/$defs/sha256"
    },
    "execution_contract": {
      "$ref": "urn:hpi:wire:validation-runtime-common:v1#/$defs/schema_set_ref"
    },
    "validation_contract": {
      "$ref": "urn:hpi:wire:validation-runtime-common:v1#/$defs/schema_set_ref"
    },
    "authority": {
      "$ref": "urn:hpi:wire:validation-runtime-common:v1#/$defs/authority"
    },
    "retry_of": {
      "$ref": "urn:hpi:wire:execution-common:v2#/$defs/frozen_ref"
    },
    "declared_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
