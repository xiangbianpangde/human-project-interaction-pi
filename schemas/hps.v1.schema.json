{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hpi:wire:hps:v1",
  "title": "HPI Wire v1 HumanProjectState",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project_id",
    "projection_id",
    "projector_revision",
    "source_snapshot",
    "source_digest",
    "phase",
    "intent",
    "pains",
    "active_work",
    "changes_since_last_seen",
    "unresolved",
    "risks",
    "decision_request_ids",
    "evidence_summary",
    "trace_link_ids"
  ],
  "properties": {
    "schema": { "const": "hpi/wire/hps/v1" },
    "project_id": { "$ref": "urn:hpi:wire:common:v1#/$defs/non_empty_string" },
    "projection_id": { "$ref": "urn:hpi:wire:common:v1#/$defs/sha256" },
    "projector_revision": { "$ref": "urn:hpi:wire:common:v1#/$defs/non_empty_string" },
    "source_snapshot": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "urn:hpi:wire:common:v1#/$defs/source_ref" }
    },
    "source_digest": { "$ref": "urn:hpi:wire:common:v1#/$defs/sha256" },
    "phase": { "$ref": "urn:hpi:wire:common:v1#/$defs/project_phase" },
    "intent": { "$ref": "#/$defs/intent" },
    "pains": {
      "type": "array",
      "items": { "$ref": "#/$defs/pain" }
    },
    "active_work": {
      "type": "array",
      "items": { "$ref": "#/$defs/active_work" }
    },
    "changes_since_last_seen": {
      "type": "array",
      "items": { "$ref": "urn:hpi:wire:common:v1#/$defs/non_empty_string" }
    },
    "unresolved": {
      "type": "array",
      "items": { "$ref": "#/$defs/unresolved" }
    },
    "risks": {
      "type": "array",
      "items": { "$ref": "urn:hpi:wire:common:v1#/$defs/non_empty_string" }
    },
    "decision_request_ids": {
      "type": "array",
      "items": { "$ref": "urn:hpi:wire:common:v1#/$defs/non_empty_string" }
    },
    "evidence_summary": { "$ref": "#/$defs/evidence_summary" },
    "trace_link_ids": {
      "type": "array",
      "items": { "$ref": "urn:hpi:wire:common:v1#/$defs/non_empty_string" }
    }
  },
  "$defs": {
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "source_ref"],
      "properties": {
        "statement": { "$ref": "urn:hpi:wire:common:v1#/$defs/non_empty_string" },
        "source_ref": { "$ref": "urn:hpi:wire:common:v1#/$defs/source_ref" }
      }
    },
    "pain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pain_id", "statement", "status", "remaining_gap", "source_ref"],
      "properties": {
        "pain_id": { "$ref": "urn:hpi:wire:common:v1#/$defs/non_empty_string" },
        "statement": { "$ref": "urn:hpi:wire:common:v1#/$defs/non_empty_string" },
        "status": { "$ref": "urn:hpi:wire:common:v1#/$defs/pain_status" },
        "remaining_gap": { "type": "string" },
        "source_ref": { "$ref": "urn:hpi:wire:common:v1#/$defs/source_ref" }
      }
    },
    "active_work": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "why_now", "machine_status", "human_status", "latest_change"],
      "properties": {
        "task_id": { "$ref": "urn:hpi:wire:common:v1#/$defs/non_empty_string" },
        "why_now": { "$ref": "urn:hpi:wire:common:v1#/$defs/non_empty_string" },
        "machine_status": { "$ref": "urn:hpi:wire:common:v1#/$defs/machine_verdict" },
        "human_status": { "$ref": "urn:hpi:wire:common:v1#/$defs/human_status" },
        "latest_change": { "$ref": "urn:hpi:wire:common:v1#/$defs/non_empty_string" },
        "result_ref": { "$ref": "urn:hpi:wire:common:v1#/$defs/source_ref" },
        "decision_ref": { "$ref": "urn:hpi:wire:common:v1#/$defs/source_ref" }
      }
    },
    "unresolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unresolved_id", "statement", "source_ref"],
      "properties": {
        "unresolved_id": { "$ref": "urn:hpi:wire:common:v1#/$defs/non_empty_string" },
        "statement": { "$ref": "urn:hpi:wire:common:v1#/$defs/non_empty_string" },
        "source_ref": { "$ref": "urn:hpi:wire:common:v1#/$defs/source_ref" }
      }
    },
    "evidence_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified", "self_reported", "not_run", "incomplete"],
      "properties": {
        "verified": { "type": "integer", "minimum": 0 },
        "self_reported": { "type": "integer", "minimum": 0 },
        "not_run": { "type": "integer", "minimum": 0 },
        "incomplete": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
