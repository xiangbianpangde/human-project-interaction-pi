{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hpi:wire:escalation-request:v1",
  "title": "HPI Wire v1 HumanEscalationRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "project_id",
    "gate_revision",
    "category",
    "decision_unit",
    "question",
    "current_facts",
    "options",
    "recommendation",
    "safe_default_if_no_answer",
    "affected_revisions",
    "request_digest",
    "one_question"
  ],
  "properties": {
    "schema": { "const": "hpi/wire/escalation-request/v1" },
    "request_id": { "$ref": "urn:hpi:wire:common:v1#/$defs/non_empty_string" },
    "project_id": { "$ref": "urn:hpi:wire:common:v1#/$defs/non_empty_string" },
    "gate_revision": { "$ref": "urn:hpi:wire:common:v1#/$defs/non_empty_string" },
    "category": { "$ref": "urn:hpi:wire:common:v1#/$defs/human_category" },
    "decision_unit": { "$ref": "urn:hpi:wire:common:v1#/$defs/non_empty_string" },
    "question": {
      "type": "string",
      "minLength": 2,
      "pattern": "^[^?？]*[?？][^?？]*$"
    },
    "current_facts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/current_fact" }
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/option" }
    },
    "recommendation": { "$ref": "urn:hpi:wire:common:v1#/$defs/non_empty_string" },
    "safe_default_if_no_answer": { "const": "NO_STATE_CHANGE" },
    "affected_revisions": {
      "type": "array",
      "items": { "$ref": "urn:hpi:wire:common:v1#/$defs/source_ref" }
    },
    "expires_at": { "type": "string", "format": "date-time" },
    "request_digest": { "$ref": "urn:hpi:wire:common:v1#/$defs/sha256" },
    "one_question": { "const": true }
  },
  "$defs": {
    "current_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "source_ref", "evidence_status"],
      "properties": {
        "statement": { "$ref": "urn:hpi:wire:common:v1#/$defs/non_empty_string" },
        "source_ref": { "$ref": "urn:hpi:wire:common:v1#/$defs/source_ref" },
        "evidence_status": {
          "type": "string",
          "enum": ["VERIFIED", "SELF_REPORTED", "NOT_RUN", "INCOMPLETE"]
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["option_id", "label", "consequences", "risks", "reversibility"],
      "properties": {
        "option_id": { "$ref": "urn:hpi:wire:common:v1#/$defs/non_empty_string" },
        "label": { "$ref": "urn:hpi:wire:common:v1#/$defs/non_empty_string" },
        "consequences": { "$ref": "urn:hpi:wire:common:v1#/$defs/non_empty_string" },
        "risks": { "type": "string" },
        "reversibility": { "type": "boolean" }
      }
    }
  }
}
