{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hpi:wire:stale-report:v1",
  "title": "HPI Execution Wire v1 Stale Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "stale_report_id",
    "report_revision",
    "upstream_before",
    "upstream_after",
    "effects",
    "detected_at",
    "reconciler_mode",
    "report_authority",
    "project_canonical_changed",
    "provenance_refs"
  ],
  "properties": {
    "schema": { "const": "hpi/wire/stale-report/v1" },
    "stale_report_id": { "$ref": "urn:hpi:wire:common:v1#/$defs/non_empty_string" },
    "report_revision": { "$ref": "urn:hpi:wire:common:v1#/$defs/sha256" },
    "upstream_before": { "$ref": "urn:hpi:wire:execution-common:v1#/$defs/frozen_ref" },
    "upstream_after": { "$ref": "urn:hpi:wire:execution-common:v1#/$defs/frozen_ref" },
    "effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_ref", "relation", "disposition", "reason", "automatic_invalidation"],
        "properties": {
          "target_ref": { "$ref": "urn:hpi:wire:execution-common:v1#/$defs/frozen_ref" },
          "relation": { "$ref": "urn:hpi:wire:common:v1#/$defs/trace_relation" },
          "disposition": { "type": "string", "enum": ["STALE", "NEEDS_REVIEW"] },
          "reason": { "$ref": "urn:hpi:wire:common:v1#/$defs/non_empty_string" },
          "automatic_invalidation": { "const": false }
        }
      }
    },
    "detected_at": { "type": "string", "format": "date-time" },
    "reconciler_mode": { "const": "PREVIEW_ONLY" },
    "report_authority": { "const": "DERIVED_PREVIEW_NOT_PROJECT_CANONICAL" },
    "project_canonical_changed": { "const": false },
    "provenance_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "urn:hpi:wire:execution-common:v1#/$defs/frozen_ref" }
    }
  }
}
