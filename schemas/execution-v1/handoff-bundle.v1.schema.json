{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hpi:wire:handoff-bundle:v1",
  "title": "HPI Execution Wire v1 HandoffBundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "handoff_id",
    "handoff_revision",
    "task_ref",
    "sender",
    "receiver",
    "input_revisions",
    "objective",
    "non_goals",
    "permission_scope",
    "expected_output",
    "acceptance_ref",
    "failure_semantics",
    "context_summary",
    "safe_default",
    "idempotency_key",
    "changed_fields",
    "provenance_refs",
    "created_at"
  ],
  "properties": {
    "schema": { "const": "hpi/wire/handoff-bundle/v1" },
    "handoff_id": { "$ref": "urn:hpi:wire:common:v1#/$defs/non_empty_string" },
    "handoff_revision": { "$ref": "urn:hpi:wire:common:v1#/$defs/sha256" },
    "task_ref": { "$ref": "urn:hpi:wire:execution-common:v1#/$defs/frozen_ref" },
    "sender": { "$ref": "urn:hpi:wire:execution-common:v1#/$defs/agent" },
    "receiver": { "$ref": "urn:hpi:wire:execution-common:v1#/$defs/agent" },
    "input_revisions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "urn:hpi:wire:execution-common:v1#/$defs/frozen_ref" }
    },
    "objective": { "$ref": "urn:hpi:wire:common:v1#/$defs/non_empty_string" },
    "non_goals": {
      "type": "array",
      "items": { "$ref": "urn:hpi:wire:common:v1#/$defs/non_empty_string" }
    },
    "permission_scope": { "$ref": "urn:hpi:wire:execution-common:v1#/$defs/permission_scope" },
    "expected_output": { "$ref": "urn:hpi:wire:common:v1#/$defs/non_empty_string" },
    "acceptance_ref": { "$ref": "urn:hpi:wire:execution-common:v1#/$defs/frozen_ref" },
    "failure_semantics": { "$ref": "urn:hpi:wire:common:v1#/$defs/non_empty_string" },
    "context_summary": { "$ref": "urn:hpi:wire:execution-common:v1#/$defs/context_summary" },
    "safe_default": { "const": "NO_STATE_CHANGE" },
    "idempotency_key": { "$ref": "urn:hpi:wire:common:v1#/$defs/sha256" },
    "supersedes": { "$ref": "urn:hpi:wire:execution-common:v1#/$defs/frozen_ref" },
    "changed_fields": { "$ref": "urn:hpi:wire:execution-common:v1#/$defs/changed_fields" },
    "provenance_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "urn:hpi:wire:execution-common:v1#/$defs/frozen_ref" }
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "supersedes": {} }, "required": ["supersedes"] },
      "then": { "properties": { "changed_fields": { "type": "array", "minItems": 1 } } }
    }
  ]
}
