{
  "name": "human-project-interaction-pi",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Read-only Human Project State plus a machine-only isolated validation-attempt runtime with frozen wire contracts, deterministic replay/recovery, and no canonical or HumanResult authority.",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:wire": "node --test tests/wire-contract.test.mjs",
    "test:execution-wire": "node --test tests/execution-wire.test.mjs",
    "test:validation-runtime": "node --test tests/validation-runtime-contract.test.mjs tests/validation-runtime-store.test.mjs tests/validation-runtime.test.mjs",
    "test:validation-contract": "node --test tests/validation-runtime-contract.test.mjs",
    "test:ricl": "node --test tests/integration/ricl-real.mjs",
    "test:install": "node --test tests/install.test.mjs",
    "validate:skill": "node scripts/validate-skill.mjs",
    "verify": "npm run test && npm run validate:skill",
    "link:install": "node scripts/link-install.mjs install",
    "link:status": "node scripts/link-install.mjs status",
    "link:uninstall": "node scripts/link-install.mjs uninstall"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2"
  }
}
